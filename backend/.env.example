SUPABASE_URL=
# Server only: bypasses row-level security. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > API in Supabase. Used to check passwords when someone signs in.
SUPABASE_ANON_KEY=
# HS256 key shared with the frontend, which verifies the session cookie.
SESSION_SECRET=
# Wrong passwords allowed per account and client in the window, before sign-in is refused.
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=300
# Wrong answers allowed per bot, per team. Defaults to 10.
MAX_WRONG_ANSWERS=10
# Development only, and never on at the real event. true signs anyone in with no
# password, and the app refuses to start if it's on while ENVIRONMENT is production.
DEV_FAKE_AUTH=false
# Set this to development to allow DEV_FAKE_AUTH, and to send the session cookie over
# plain HTTP. Anything else needs HTTPS, because the cookie is then marked Secure.
ENVIRONMENT=production

# Model keys. A bot whose host has no key refuses messages with a clear error.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Messages a team can send in the window. Failed turns don't count.
CHAT_RATE_LIMIT_MESSAGES=6
CHAT_RATE_LIMIT_WINDOW_SECONDS=30
# Unfinished turns a team can have at once. Independent of LiteLLM dollar budgets.
CHAT_MAX_OPEN_TURNS=3
# Output tokens per model call, reasoning included. A turn with tools makes several.
CHAT_MAX_OUTPUT_TOKENS=2048

# Gateway enabled by default. Set false only for explicit direct-provider testing.
# See deploy/litellm/README.md. Keep files outside the public app.
LITELLM_ENABLED=true
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_ROUTES_FILE=/absolute/path/to/deploy/litellm/runtime/routes.json
LITELLM_TEAM_KEYS_FILE=/absolute/path/to/deploy/litellm/runtime/team-keys.json

# The judge that grades Levels 2 to 5. Its key is separate from team budgets, because
# grading is an organiser cost. In production the app refuses to start on the mock,
# which fails real conversations. Use a model that won't refuse Levels 3 to 5 content
# and reads Hindi and Hinglish well. Any OpenAI-style API works.
JUDGE_PROVIDER=openai_compatible
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
# Raise this to the model's real limit. A longer conversation can't be graded.
JUDGE_MAX_CONTEXT_TOKENS=8000
# true checks each pass with a second call. It costs more and is more cautious.
JUDGE_CONFIRM_PASSES=false

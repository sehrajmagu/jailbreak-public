# Reference only. `python3 setup.py init` creates the real .env in this folder,
# with random values for the three infrastructure secrets below. Never commit .env.

LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.106.6

# Generated by `setup.py init`. The master key is the gateway's admin password.
LITELLM_MASTER_KEY=sk-replace-with-random-hex
# Encrypts provider credentials stored in the accounting database. Don't change it
# after setup unless you also re-enter every stored credential.
LITELLM_SALT_KEY=replace-with-random-hex
POSTGRES_PASSWORD=replace-with-random-hex

# Provider keys. Each model in runtime/models.json names one slot with `key_slot`.
# The slots can be any mix of supported providers.
PROVIDER_KEY_1=
PROVIDER_KEY_2=
PROVIDER_KEY_3=
PROVIDER_KEY_4=

# Only for AWS Bedrock models that use IAM credentials.
AWS_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Only for Cloudflare Workers AI. See CLOUDFLARE.md.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PLAN=

# Copy this to .env.local in the repo root, next to package.json. Next.js doesn't read
# anything in backend/, so the website can't see the settings in that folder.

# true: use the built-in mock API (/api/mock/*). false: call the real backend.
NEXT_PUBLIC_USE_MOCK=true

# Real backend only. Same-origin path or URL of the API, without a trailing slash.
# NEXT_PUBLIC_API_URL=/api

# Real backend only. Where the website sends /api requests. Defaults to port 8000.
# BACKEND_URL=http://localhost:8000

# Real backend only. HS256 key shared with the backend, used to verify the session cookie.
# SESSION_SECRET=change-me
